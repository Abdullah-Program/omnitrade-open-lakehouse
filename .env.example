# ==============================================================================
# DTCC OPEN LAKEHOUSE: ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AWS Cloud Storage & IAM (US-East-1 recommended for lowest latency & cost)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SESSION_TOKEN=               # Optional: Leave empty if using permanent IAM credentials

# S3 Bucket Setup (Bronze = Raw/Iceberg, Warehouse = Query Results & Spills)
S3_BUCKET_NAME=dtcc-open-lakehouse-bronze
S3_WAREHOUSE_PATH=s3://dtcc-open-lakehouse-bronze/iceberg/warehouse/
S3_RAW_LANDING_PATH=s3://dtcc-open-lakehouse-bronze/raw/dtcc/

# AWS Glue Service Configuration
GLUE_DATABASE_NAME=dtcc_lakehouse_catalog
GLUE_ROLE_ARN=arn:aws:iam::123456789012:role/GlueIcebergExecutionRole

# ------------------------------------------------------------------------------
# 2. Apache Polaris REST Catalog Configuration
# ------------------------------------------------------------------------------
POLARIS_HOST=localhost
POLARIS_PORT=8181
POLARIS_BASE_URL=http://localhost:8181/api/catalog/v1
POLARIS_CATALOG_NAME=dtcc_catalog
POLARIS_CLIENT_ID=polaris-admin
POLARIS_CLIENT_SECRET=polaris-secret
POLARIS_REALM=default-realm

# ------------------------------------------------------------------------------
# 3. Snowflake Warehouse & Database Configuration (30-day Free Trial)
# ------------------------------------------------------------------------------
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=LAKEHOUSE_ADMIN
SNOWFLAKE_PASSWORD=YourStrongPasswordHere123!
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=DTCC_LAKEHOUSE
SNOWFLAKE_SCHEMA=PUBLIC

# Snowflake Integrations for Polaris & S3
SNOWFLAKE_EXTERNAL_VOLUME=dtcc_s3_volume
SNOWFLAKE_CATALOG_INTEGRATION=polaris_catalog_integration

# ------------------------------------------------------------------------------
# 4. Pipeline Runtime & Benchmarking Flags
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
SAMPLE_DATA_SIZE=100000          # Number of trades to simulate if live API offline
BENCHMARK_ITERATIONS=3           # Warm vs Cold cache benchmark iterations
